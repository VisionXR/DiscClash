      m_Calls: []
  m_text: "Welcome to Disc Pool \u2014 a fresh blend of Pool and Snooker rules, played
    with the flick mechanics of Carrom. \n\nInstead of balls, you\u2019ll be playing
    with discs, and instead of a cue ball, you\u2019ll use a striker.\n \nThe board
    is compact and rotates like a lazy-Susan, giving you full 360-degree control.
    \n\nThis is a brand-new experience. Let\u2019s begin."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 5302535af1044152a457ed104f1f4b91, type: 2}
